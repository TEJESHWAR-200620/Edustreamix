# Owner inbox — students email their Razorpay payment ID here themselves.
# Owner sends certificates back manually. No auto-email is sent by the server.
OWNER_EMAIL=t.harinarayana@gmail.com

# Razorpay — paste your key in your local .env (never commit real secrets).
# KEY_ID is public (sent to browser via /api/config for Checkout).
RAZORPAY_KEY_ID=rzp_live_paste_your_key_here

# Optional
PORT=5500
