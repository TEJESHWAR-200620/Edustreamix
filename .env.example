# Manual verification inbox — students email their Razorpay payment ID here themselves.
# No auto-email is sent by the server.
OWNER_EMAIL=t.harinarayana@gmail.com

# Owner panel login — server-side only, never in frontend code
ADMIN_USERNAME=admin12ou
ADMIN_KEY=admin1234
ADMIN_EMAIL=admin12ou@gmail.com

# Razorpay — paste your keys in your local .env (never commit real secrets).
# KEY_ID is public (sent to browser via /api/config for Checkout).
# KEY_SECRET stays server-only, never sent to browser.
RAZORPAY_KEY_ID=rzp_live_paste_your_key_here
RAZORPAY_KEY_SECRET=paste_your_secret_here

# Optional
PORT=5500
